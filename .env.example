# .env.example
# Copy this file to .env and update the values
# The setup.sh script will automatically generate secure passwords

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# SQL Server Password (Auto-generated by setup.sh)
# Must be strong: 8+ chars, uppercase, lowercase, number, special char
MSSQL_SA_PASSWORD=YourStrong@Passw0rd

# Redis Password (Auto-generated by setup.sh)
# Recommended: Use strong password for production
REDIS_PASSWORD=YourRedis@Passw0rd

# Full Connection Strings (Optional - override the default connection strings)
# Uncomment and modify these if you need custom connection strings
# SQL_CONNECTION_STRING=Server=db;Database=AICalendarDb;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;MultipleActiveResultSets=True;
# REDIS_CONNECTION_STRING=redis:6379,password=YourRedis@Passw0rd,abortConnect=false

# Seq admin password (for Seq admin UI)
SEQ_ADMIN_PASSWORD=YourSeq@Passw0rd
